rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function uid() {
      return request.auth.uid;
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'patient';
    }

    function role() {
      // request.auth.token.role throws if the custom claim was never set
      // (true for every user in this app, since nothing sets custom claims),
      // so it must be read with get(), not dot-notation.
      return request.auth.token.get('role', null) != null
        ? request.auth.token.get('role', null)
        : userRole();
    }

    function isDoctor() {
      return role() in ['doctor', 'admin'];
    }

    function isPatient() {
      return role() == 'patient';
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    function isImmutableRoleChange() {
      return request.resource.data.role == resource.data.role;
    }

    function isImmutableOwnerChange() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    function isAppointmentCoreUnchanged() {
      return request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.get('slotId', null) == resource.data.get('slotId', null)
        && request.resource.data.date == resource.data.date
        && request.resource.data.time == resource.data.time
        && request.resource.data.get('patientId', null) == resource.data.get('patientId', null)
        && request.resource.data.get('uid', null) == resource.data.get('uid', null);
    }

    match /users/{userId} {
      allow read: if isVerified() && (isOwner(userId) || isDoctor());
      // Signup creates this doc before the user has clicked the verification
      // link, so create must not require isVerified() — only read/update do.
      allow create: if isSignedIn() && isOwner(userId)
        && request.resource.data.keys().hasAll(['email', 'role'])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'patient';
      allow update: if isVerified() && isOwner(userId)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /profiles/{profileId} {
      allow read: if isVerified() && (isOwner(profileId) || isDoctor());
      allow create: if isSignedIn() && isOwner(profileId)
        && request.resource.data.keys().hasAll(['ownerId', 'role'])
        && request.resource.data.ownerId == profileId
        && request.resource.data.role == role();
      allow update: if isVerified() && isOwner(profileId)
        && isImmutableRoleChange()
        && isImmutableOwnerChange();
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read: if isVerified() && (isOwner(patientId) || isDoctor());
      allow create: if isSignedIn() && isOwner(patientId)
        && request.resource.data.keys().hasAll(['ownerId', 'role'])
        && request.resource.data.ownerId == patientId
        && request.resource.data.role == 'patient';
      allow update: if isVerified() && isOwner(patientId)
        && isImmutableRoleChange()
        && isImmutableOwnerChange();
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if isVerified() && (
        isOwner(resource.data.get('patientId', null)) ||
        isOwner(resource.data.get('uid', null)) ||
        isDoctor() ||
        isOwner(resource.data.get('doctorId', null))
      );
      allow create: if isVerified() && isPatient()
        && request.resource.data.keys().hasAll(['status'])
        && (
          request.resource.data.get('patientId', null) == uid() ||
          request.resource.data.get('uid', null) == uid()
        )
        && request.resource.data.status in ['pending', 'booked', 'confirmed'];
      allow update: if isVerified() && isAppointmentCoreUnchanged() && (
        (isPatient() && (
          isOwner(resource.data.get('patientId', null)) ||
          isOwner(resource.data.get('uid', null))
        )
          // Patients may only cancel their own booked/confirmed appointment,
          // not mark it completed or otherwise tamper with its status.
          && resource.data.status in ['booked', 'confirmed']
          && request.resource.data.status == 'cancelled') ||
        (isDoctor() && resource.data.doctorId != null && isOwner(resource.data.doctorId))
      );
      allow delete: if false;
    }

    match /availability/{availabilityId} {
      allow read: if isVerified();
      allow create: if isVerified() && isDoctor()
        && request.resource.data.keys().hasAll(['doctorId', 'day', 'startTime', 'endTime'])
        && request.resource.data.doctorId == uid();
      allow update: if isVerified() && isDoctor()
        && resource.data.doctorId == uid()
        && request.resource.data.doctorId == uid();
      allow delete: if isVerified() && isDoctor() && resource.data.doctorId == uid();
    }

    function isSlotCoreUnchanged() {
      return request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.date == resource.data.date
        && request.resource.data.time == resource.data.time;
    }

    // A patient books a slot directly (no server-side function on the free
    // Spark plan): flips available -> booked. Ownership is enforced on the
    // appointment doc itself, created in the same client transaction.
    function isPatientBookingSlot() {
      return isPatient()
        && resource.data.status == 'available'
        && request.resource.data.status == 'booked'
        && isSlotCoreUnchanged();
    }

    // A patient cancels their own appointment: flips booked -> available.
    // The linked appointment must already exist and belong to the caller,
    // so a patient can't free up someone else's booked slot.
    function isPatientCancellingSlot() {
      return isPatient()
        && resource.data.status == 'booked'
        && request.resource.data.status == 'available'
        && isSlotCoreUnchanged()
        && resource.data.appointmentId is string
        && get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.patientId == uid();
    }

    match /slots/{slotId} {
      allow read: if isVerified();
      allow create: if isVerified() && isDoctor()
        && request.resource.data.keys().hasAll(['doctorId', 'date', 'time'])
        && request.resource.data.doctorId == uid();
      allow update: if isVerified() && (
        (isDoctor() && resource.data.doctorId == uid() && request.resource.data.doctorId == uid()) ||
        isPatientBookingSlot() ||
        isPatientCancellingSlot()
      );
      allow delete: if isVerified() && isDoctor() && resource.data.doctorId == uid();
    }

    match /notifications/{notificationId} {
      allow read: if isVerified() && (
        isOwner(resource.data.get('userId', null)) ||
        isOwner(resource.data.get('uid', null)) ||
        isDoctor()
      );
      allow create, update: if isVerified() && isDoctor();
      allow delete: if false;
    }

    match /doctorNotes/{noteId} {
      allow read, write: if isVerified() && isDoctor();
    }

    match /healthReports/{reportId} {
      allow read: if isVerified() && (isOwner(resource.data.patientId) || isDoctor());
      allow create: if isVerified() && (
        isOwner(request.resource.data.patientId) || isDoctor()
      );
      allow update: if isVerified() && (isOwner(resource.data.patientId) || isDoctor());
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // calendarSettings holds Google OAuth tokens; only Cloud Functions (Admin SDK) may read/write it.
    match /calendarSettings/{settingId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
